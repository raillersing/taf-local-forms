# Required before starting Docker. Generate a unique value with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=false
SECRET_KEY=

# Required before starting Docker. Use a unique password, not a placeholder.
POSTGRES_PASSWORD=
POSTGRES_DB=taf_local_forms
POSTGRES_USER=taf

ALLOWED_HOSTS=localhost,127.0.0.1,[::1],<LAPTOP_LAN_IP>
CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://<LAPTOP_LAN_IP>:8010,http://<LAPTOP_LAN_IP>:8011
DATABASE_PATH=/app/data/db.sqlite3
TIME_ZONE=Indian/Antananarivo

# Port hôte du conteneur (defaut : 8010)
TAF_HOST_PORT=8010

# Adresse IP locale du laptop à afficher aux élèves (optionnel)
# Si vide, la page "Accès réseau" tente de détecter l'IP automatiquement.
TAF_LAN_HOST=
